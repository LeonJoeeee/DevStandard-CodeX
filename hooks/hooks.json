{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|resume|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/session-start\" orchestrator 1 8",
            "async": false,
            "additionalContextLimit": 0
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/session-start\" orchestrator 2 8",
            "async": false,
            "additionalContextLimit": 0
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/session-start\" orchestrator 3 8",
            "async": false,
            "additionalContextLimit": 0
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/session-start\" orchestrator 4 8",
            "async": false,
            "additionalContextLimit": 0
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/session-start\" orchestrator 5 8",
            "async": false,
            "additionalContextLimit": 0
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/session-start\" orchestrator 6 8",
            "async": false,
            "additionalContextLimit": 0
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/session-start\" orchestrator 7 8",
            "async": false,
            "additionalContextLimit": 0
          },
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/session-start\" orchestrator 8 8",
            "async": false,
            "additionalContextLimit": 0
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/hooks/pre-tool-use\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
