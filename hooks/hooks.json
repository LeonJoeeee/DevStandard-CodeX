{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup|clear|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT}/hooks/session-start\" orchestrator 1 8",
            "async": false
          },
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT}/hooks/session-start\" orchestrator 2 8",
            "async": false
          },
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT}/hooks/session-start\" orchestrator 3 8",
            "async": false
          },
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT}/hooks/session-start\" orchestrator 4 8",
            "async": false
          },
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT}/hooks/session-start\" orchestrator 5 8",
            "async": false
          },
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT}/hooks/session-start\" orchestrator 6 8",
            "async": false
          },
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT}/hooks/session-start\" orchestrator 7 8",
            "async": false
          },
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT}/hooks/session-start\" orchestrator 8 8",
            "async": false
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "\"${CODEX_PLUGIN_ROOT}/hooks/pre-tool-use\"",
            "timeout": 30
          }
        ]
      }
    ]
  }
}
