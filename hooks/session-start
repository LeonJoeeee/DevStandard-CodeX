#!/usr/bin/env bash
# Deliver one complete role page inline. The fixed budget includes the header.
# additionalContextLimit=0 disables Codex spilling; it does not relax this safety cap.
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "$0")" && pwd)"
ROOT="$(cd "${SCRIPT_DIR}/.." && pwd)"

python3 - "$ROOT" "$@" <<'PYTHON'
import json, sys
from pathlib import Path

CAP_BYTES = 64000
MARKER = '--- codex-method whole context ---\n'
root = Path(sys.argv[1])

def stop(reason):
    print(json.dumps({'continue': False, 'stopReason': 'codex-method: ' + reason}))
    raise SystemExit(0)

if len(sys.argv) > 3:
    stop('one role argument is supported; numbered part delivery was removed')
role = sys.argv[2] if len(sys.argv) == 3 else 'orchestrator'
page = root / 'reference' / (role + '.md')
header = (f'codex-method operating context: reference/{role}.md\n'
          f'Resolve references from: {root}\n'
          'Follow this whole page before acting or replying; load referenced pages only at their triggers.\n'
          + MARKER)
try:
    data = page.read_bytes()
except FileNotFoundError:
    stop('required role page is missing at ' + str(page))
except OSError as error:
    stop('required role page cannot be read: ' + str(error))
if len(header.encode('utf-8')) + len(data) > CAP_BYTES:
    stop('complete additionalContext exceeds the fixed 64000 UTF-8 byte budget; refusing partial context')
try:
    text = data.decode('utf-8')
except UnicodeDecodeError:
    stop('required role page is not valid UTF-8: ' + str(page))
if not text.strip():
    stop('required role page is empty at ' + str(page))
print(json.dumps({'hookSpecificOutput': {
    'hookEventName': 'SessionStart', 'additionalContext': header + text}}, ensure_ascii=False))
PYTHON
