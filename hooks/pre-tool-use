#!/bin/sh
# The role hook: three refusals and one standing rule, whole-word matches on the command text.
role=''
while [ $# -gt 0 ]; do
  case "$1" in
    --role) role="$2"; shift 2 ;;
    *) shift ;;
  esac
done
[ -n "$role" ] || role=worker
text=$(cat 2>/dev/null || true)
deny() {
  printf '%s\n' "refused ($role): $1" >&2
  printf '%s\n' "$2" >&2
  exit 1
}
case "$text" in
  *"git merge"*) [ "$role" = worker ] && deny 'a worker never merges' 'Push the PR and let the orchestrator run scripts/guard merge.' ;;
esac
case "$text" in
  *"gh pr merge"*) deny 'the orchestrator merges through the guard' 'Run: scripts/guard merge --repo OWNER/REPO --pr NUMBER --project CHECKOUT --execute' ;;
esac
if [ "$role" = reviewer ]; then
  case "$text" in
    *'gh api'*|*'--method'*|*' -X '*) deny 'a reviewer is read-only' 'Return a verdict; publication is the caller\'s job.' ;;
  esac
fi
case "$text" in
  *"git push"*|*"push"*main*|*"push"*master*)
    case "$text" in
      *"git push"*)
        case "$text" in
          *main*|*master*) [ "$role" = worker ] && deny 'a worker never pushes main or master' 'Push your task branch only.' ;;
        esac ;;
    esac ;;
esac
exit 0
