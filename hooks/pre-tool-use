#!/usr/bin/env python3
"""The role hook.

Checks ordinary Unix/Windows command argv, including wrappers, executable paths and direct
PowerShell mutators. Search arguments are not commands. This is a policy hook, not a shell
interpreter or OS isolation;
interpreter bodies, runtime-built operations and arbitrary MCP writes remain outside its boundary.
"""
import json
import re
import shlex
import sys

NATIVE_PAYLOAD = False


def executable_name(value):
    """Normalize ordinary executable paths and PowerShell module-qualified cmdlets."""
    name = re.split(r'[/\\]', value)[-1].lower()
    return re.sub(r'\.(?:exe|cmd|bat|com)$', '', name)


def windows_syntax(text, shell='', tool=''):
    # An explicitly selected Unix shell retains POSIX escapes, even on a Windows host.
    if shell:
        return executable_name(shell) in ('powershell', 'pwsh', 'cmd')
    if sys.platform == 'win32' and tool != 'Bash':
        return True
    # Compatibility payloads have no shell field. A direct drive/UNC path is unambiguous.
    return bool(re.search(r'''(?:^|[;&|\n])\s*&?\s*['"]?(?:[A-Za-z]:[\\/]|\\\\)''', text))


def shell_commands(text, windows=False):
    """Parse direct command segments and redirects, not interpreter bodies or expressions."""
    text = re.sub(r"<<-?\s*'?(\w+)'?\n.*?\n\1", ' ', text, flags=re.S)
    # shlex's punctuation tokens discard whether a quoted ";" was an argv value.
    # Split separators first while retaining their quote/escape context, then parse each argv.
    segments, current, quote, escaped, commented = [], [], None, False, False
    redirects = False
    escape = '`' if windows else '\\'
    for index, character in enumerate(text + '\n'):
        if commented:
            if character != '\n':
                continue
            commented = False
        if escaped:
            current.append(character)
            escaped = False
        elif character == escape and quote != "'":
            current.append(character)
            escaped = True
        elif quote:
            current.append(character)
            if character == quote:
                quote = None
        elif character in ("'", '"'):
            current.append(character)
            quote = character
        elif character == '#' and (not current or current[-1].isspace()):
            commented = True
        elif character == '>':
            # Stream routing (2>&1) and quoted/escaped prose do not write a file.
            if index + 1 >= len(text) or text[index + 1] != '&':
                redirects = True
            current.append(character)
        elif character in ';&|\n':
            if current:
                try:
                    lexer = shlex.shlex(''.join(current), posix=True)
                    lexer.whitespace_split = True
                    lexer.commenters = ''
                    lexer.escape = escape
                    argv = list(lexer)
                except ValueError:
                    return [], redirects
                if argv:
                    segments.append(argv)
            current = []
        else:
            current.append(character)
    commands = []
    for argv in segments:
        while argv:
            if re.match(r'^[A-Za-z_][A-Za-z_0-9]*=', argv[0]):
                argv = argv[1:]
            elif executable_name(argv[0]) == 'command':
                argv = argv[1:]
                while argv and argv[0] in ('-p', '--'):
                    argv = argv[1:]
            elif executable_name(argv[0]) == 'env':
                argv = argv[1:]
                while argv and argv[0].startswith('-'):
                    option = argv.pop(0)
                    if option in ('-u', '--unset', '-C', '--chdir') and argv:
                        argv = argv[1:]
                    if option == '--':
                        break
            else:
                break
        if argv:
            commands.append((executable_name(argv[0]), argv[1:]))
    return commands, redirects


def subcommand(args, value_options):
    index = 0
    while index < len(args) and args[index].startswith('-'):
        index += 2 if args[index] in value_options else 1
    return (args[index].lower(), args[index + 1:]) if index < len(args) else ('', [])


def unsafe_worker_push(args):
    """A push with no explicit destination can follow a main upstream or push.default."""
    values, index = [], 0
    while index < len(args):
        arg = args[index]
        if arg.split('=')[0] in ('--all', '--mirror', '--prune', '--tags', '--follow-tags'):
            return True
        if arg in ('--repo', '--receive-pack', '--exec', '-o', '--push-option'):
            index += 2
            continue
        if not arg.startswith('-'):
            values.append(arg)
        index += 1
    if len(values) < 2:
        return True
    for refspec in values[1:]:
        destination = refspec.lstrip('+').split(':')[-1]
        if (not destination or '*' in refspec or destination.upper() == 'HEAD'
                or destination.lower().split('/')[-1] in ('main', 'master')):
            return True
    return False


def tool_name(name):
    """Only known host namespaces are aliases; MCP names retain their independent identity."""
    aliases = {'collaborationspawn_agent': 'spawn_agent',
               'collaboration.spawn_agent': 'spawn_agent',
               'functions.apply_patch': 'apply_patch',
               'functions.exec_command': 'exec_command'}
    return aliases.get(name, name)


def git_write(command, args):
    if command in {'add', 'commit', 'push', 'merge', 'rebase', 'reset', 'checkout', 'switch',
                   'clean', 'restore', 'cherry-pick', 'revert', 'stash', 'fetch', 'pull',
                   'am', 'apply', 'worktree', 'update-ref'}:
        return True
    if command == 'branch':
        mutations = ('-d', '-D', '-m', '-M', '-c', '-C', '--delete', '--move', '--copy',
                     '-f', '--force', '-u', '--edit-description', '--set-upstream-to', '--unset-upstream')
        return (any(arg.split('=')[0] in mutations for arg in args)
                or bool(args and not args[0].startswith('-')))
    if command == 'tag':
        return bool(args and (args[0] not in ('--list', '-l') or '-d' in args or '--delete' in args))
    if command == 'config':
        reads = {'--get', '--get-all', '--get-regexp', '--get-urlmatch', '--list', '-l',
                 'get', 'list'}
        return bool(args and not any(arg in reads for arg in args)
                    and (len([arg for arg in args if not arg.startswith('-')]) != 1
                         or any(arg in ('--unset', '--unset-all', '--add', '--replace-all',
                                        '--remove-section', '--rename-section', '--edit', '-e',
                                        'set', 'unset', 'edit', 'remove-section', 'rename-section')
                                for arg in args)))
    if command == 'remote':
        return bool(args and args[0] in ('add', 'remove', 'rm', 'rename', 'set-url', 'set-head', 'prune', 'update'))
    return False


def deny(role, what, instead):
    reason = f'refused ({role}): {what}. {instead}'
    if NATIVE_PAYLOAD:
        print(json.dumps({'hookSpecificOutput': {
            'hookEventName': 'PreToolUse', 'permissionDecision': 'deny',
            'permissionDecisionReason': reason}}))
        sys.exit(0)
    print(reason, file=sys.stderr)
    sys.exit(2)


def main():
    global NATIVE_PAYLOAD
    # Native payloads are UTF-8 on every platform; Windows' console default is not.
    try:
        sys.stdin.reconfigure(encoding='utf-8')
        sys.stdout.reconfigure(encoding='utf-8')
    except (AttributeError, ValueError):
        pass
    role = 'orchestrator'
    argv = sys.argv[1:]
    while argv:
        if argv[0] == '--role' and len(argv) > 1:
            role = argv[1]
            argv = argv[2:]
        else:
            argv = argv[1:]
    try:
        raw = sys.stdin.read()
    except Exception:
        raw = ''
    try:
        payload = json.loads(raw)
    except Exception:
        payload = None
    NATIVE_PAYLOAD = isinstance(payload, dict)
    tool = ''
    inputs = {}
    if NATIVE_PAYLOAD:
        native_role = payload.get('agent_type')
        # Host payload identity outranks compatibility --role arguments. Main omits identity.
        roles = {'method_worker': 'worker', 'method_helper': 'worker',
                 'method_reviewer': 'reviewer', 'method_review_helper': 'reviewer'}
        if native_role:
            if native_role not in roles:
                deny(native_role, 'unqualified child role', 'Use an installed method role.')
            role = roles[native_role]
        elif payload.get('agent_id'):
            deny('unknown', 'child role is missing', 'Use an installed method role.')
        else:
            role = 'orchestrator'
        tool = tool_name(payload.get('tool_name', ''))
        inputs = payload.get('tool_input') or {}
        if not isinstance(inputs, dict):
            deny(role, 'unrecognized tool input', 'Supply the native structured tool input.')
        text = inputs.get('command', inputs.get('cmd', ''))
    else:
        text = raw
    if role == 'reviewer':
        if tool.lower() in ('apply_patch', 'write', 'edit', 'multiedit', 'write_file', 'edit_file'):
            deny(role, 'a reviewer is read-only', 'Return a verdict; publication is the caller\'s job.')
        if tool == 'spawn_agent' and (inputs.get('agent_type') != 'method_review_helper'
                                      or inputs.get('fork_turns') != 'none'):
            deny(role, 'reviewer helpers must keep the reviewer role and fresh context',
                 'Spawn method_review_helper with fork_turns="none".')
    if not isinstance(text, str):
        deny(role, 'unrecognized command', 'Supply the native command string.')
    commands, redirects = shell_commands(text, windows_syntax(text, inputs.get('shell', ''), tool))
    git_argv = [subcommand(args, ('-C', '-c', '--git-dir', '--work-tree', '--namespace', '--config-env'))
                for executable, args in commands if executable == 'git']
    gh_argv = [subcommand(args, ('-R', '--repo', '--hostname'))
               for executable, args in commands if executable == 'gh']

    # The REST merge endpoints merge a PR or write a merge commit straight onto a branch. Neither
    # goes through the guard, so neither is admitted for anyone.
    if (any(command == 'api' and any('/merge' in arg.lower() for arg in args)
            for command, args in gh_argv)
            or any(executable in ('curl', 'wget') and
                   any(re.search(r'\bpulls/\d+/merge\b', arg.lower()) for arg in args)
                   for executable, args in commands)):
        deny(role, 'a merge goes through the guard',
             'Run: scripts/guard merge --repo OWNER/REPO --pr NUMBER --project CHECKOUT --execute')

    # The guard is the merge entry point; only the orchestrator runs it with --execute.
    if any(executable == 'guard' and args and args[0] == 'merge' and '--execute' in args
           for executable, args in commands):
        if role != 'orchestrator':
            deny(role, 'only the orchestrator executes a merge',
                 'Return a PR with evidence and let the orchestrator run the guard.')

    if role == 'worker':
        if any(command == 'merge' for command, _ in git_argv):
            deny(role, 'a worker never merges',
                 'Push the PR and let the orchestrator run scripts/guard merge.')
        if any(command == 'push' and unsafe_worker_push(args) for command, args in git_argv):
            deny(role, 'a worker push needs an explicit task-branch destination',
                 'Push your named task branch only; do not use implicit upstream, main or master.')

    if role == 'reviewer':
        # Ordinary shell paths only: this is a policy hook, not a shell interpreter or an
        # OS-per-child security boundary. Scripts and runtime-built operations remain residuals.
        if (any(git_write(command, args) for command, args in git_argv)
                or any(executable in {'rm', 'mv', 'cp', 'touch', 'mkdir', 'rmdir', 'tee',
                                      'truncate', 'chmod', 'chown',
                                      'set-content', 'add-content', 'clear-content', 'out-file',
                                      'new-item', 'remove-item', 'move-item', 'copy-item', 'rename-item',
                                      'set-item', 'clear-item', 'set-itemproperty', 'new-itemproperty',
                                      'remove-itemproperty', 'clear-itemproperty', 'rename-itemproperty',
                                      'copy-itemproperty', 'move-itemproperty', 'set-acl',
                                      'export-csv', 'export-clixml', 'tee-object', 'export-pssession',
                                      'sc', 'ac', 'clc', 'ni', 'ri', 'rni', 'mi', 'ci', 'si', 'sp',
                                      'cli', 'clp', 'cpi', 'rp', 'rip', 'rnp', 'mp', 'cpp', 'epcsv',
                                      'del', 'erase', 'ren', 'rename', 'copy', 'move', 'md', 'rd',
                                      'mklink', 'attrib'} for executable, _ in commands)
                or redirects
                or any((executable == 'sed' and any(arg == '-i' or arg.startswith('--in-place')
                                                  or arg.startswith('-i') for arg in args))
                       or (executable == 'perl' and any(re.match(r'-\w*i', arg) for arg in args))
                       for executable, args in commands)
                or any(command in ('pr', 'issue', 'release', 'repo') and args and args[0] in
                       ('create', 'edit', 'comment', 'close', 'reopen', 'merge', 'delete',
                        'upload', 'fork', 'rename') for command, args in gh_argv)):
            deny(role, 'a reviewer is read-only', "Return a verdict; publication is the caller's job.")
        for command, args in gh_argv:
            if command != 'api':
                continue
            write_flags = ('--method', '--input', '--raw-field', '--field', '-f', '-F')
            if (any(arg.split('=')[0] in write_flags or arg.startswith(('-f', '-F')) for arg in args)
                    or any(arg.startswith('-X') and
                           (args[index + 1] if arg == '-X' and index + 1 < len(args)
                            else arg[2:]).upper() not in ('GET', 'HEAD')
                           for index, arg in enumerate(args))):
                deny(role, 'a reviewer is read-only',
                     "Return a verdict; publication is the caller's job.")

    if any(command == 'pr' and args and args[0] == 'merge' for command, args in gh_argv):
        deny(role, 'the orchestrator merges through the guard',
             'Run: scripts/guard merge --repo OWNER/REPO --pr NUMBER --project CHECKOUT --execute')

    sys.exit(0)


if __name__ == '__main__':
    main()
