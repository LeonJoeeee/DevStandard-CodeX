#!/usr/bin/env python3
"""The role hook.

Reads a shell command's own text, with quoted strings and here-document bodies removed, and matches
whole words. It refuses four things and admits everything else, because a word stays only where the
act is irreversible and no other layer stops it. The merge guard and branch protection carry the
rest.
"""
import json
import re
import sys


def strip_noise(text):
    """Drop quoted strings and here-document bodies; keep the command's own words."""
    text = re.sub(r"<<-?\s*'?(\w+)'?\n.*?\n\1", ' ', text, flags=re.S)
    text = re.sub(r"'[^']*'|\"[^\"]*\"|`[^`]*`", ' ', text)
    return text


def whole(word, text):
    return re.search(rf'(?<![\w-]){re.escape(word)}(?![\w-])', text) is not None


def deny(role, what, instead):
    print(f'refused ({role}): {what}', file=sys.stderr)
    print(instead, file=sys.stderr)
    sys.exit(1)


def main():
    role = 'orchestrator'
    argv = sys.argv[1:]
    while argv:
        if argv[0] == '--role' and len(argv) > 1:
            role = argv[1]
            argv = argv[2:]
        else:
            argv = argv[1:]
    try:
        raw = sys.stdin.read()
    except Exception:
        raw = ''
    try:
        payload = json.loads(raw)
        text = payload.get('tool_input', {}).get('command', '') if isinstance(payload, dict) else ''
    except Exception:
        text = raw
    text = strip_noise(text)
    lower = text.lower()

    if role == 'worker':
        if whole('merge', text) and whole('git', text):
            deny(role, 'a worker never merges',
                 'Push the PR and let the orchestrator run scripts/guard merge.')
        if whole('push', text) and (whole('main', text) or whole('master', text)):
            deny(role, 'a worker never pushes main or master',
                 'Push your task branch only.')

    if whole('merge', text) and whole('pr', text) and whole('gh', text):
        deny(role, 'the orchestrator merges through the guard',
             'Run: scripts/guard merge --repo OWNER/REPO --pr NUMBER --project CHECKOUT --execute')

    if role == 'reviewer':
        write_flags = ('--method', '--input', '-X')
        if whole('gh', text) and whole('api', text) and any(flag in text for flag in write_flags):
            deny(role, 'a reviewer is read-only',
                 'Return a verdict; publication is the caller\'s job.')

    sys.exit(0)


if __name__ == '__main__':
    main()
