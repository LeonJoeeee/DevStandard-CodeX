#!/usr/bin/env python3
"""Install native roles for the qualified Codex 0.160.0 V2 interface.

Only the explicitly selected project or user role/config scope is changed. Plugin
registration and hook trust are separate host operations. Role configs cannot enforce per-child cwd, sandbox, approvals, or hook settings.
"""
import argparse
import json
import os
import re
import shutil
import sys
import tomllib
import uuid
from pathlib import Path

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'scripts'))
from hard_edges import Refusal, helper_line, require

VERSION = '0.160.0'
MARKER = f'# Generated by codex-method scripts/install; Codex {VERSION} V2.\n'
OWNED_MARKERS = (MARKER, '# Generated by codex-method scripts/install; Codex 0.159.2 V2.\n')
FEATURES = ('enabled', 'expose_spawn_agent_model_overrides')


def role_files():
    harness = ROOT / 'reference/harness-codex.md'
    native = ('\nNative interface: Codex 0.160.0 V2 spawn_agent accepts task_name, message, '
              'agent_type, fork_turns="none", model, reasoning_effort. Use method_helper for '
              'worker helpers and method_review_helper for reviewer helpers. Reviewer helpers '
              'remain nonediting and must never spawn a generic writer.\n'
              'Children inherit the parent cwd and permissions. Set workdir to the assigned '
              'worktree on every command; no OS-per-child read-only isolation is provided.\n')
    native += helper_line(ROOT) + '\n'
    if harness.is_file():
        native += '\n' + harness.read_text()
    result = {}
    for role, source in (
            ('method_worker', 'worker.md'),
            ('method_reviewer', 'code-review-prompt.md'),
            ('method_helper', 'worker.md'),
            ('method_review_helper', 'code-review-prompt.md')):
        instructions = (ROOT / 'reference' / source).read_text() + native
        if 'review' in role:
            instructions += ('\nReviewer policy: do not edit files or repository state, run shell '
                             'mutations, or publish GitHub writes. Return the whole verdict to the '
                             'caller. Use only method_review_helper with fork_turns="none".\n')
        if role.endswith('helper'):
            instructions += ('\nYou are a task-local helper. Your caller retains lane ownership; '
                             'do only the assigned subtask and return evidence to that caller.\n')
        result[role + '.toml'] = MARKER + '\n'.join(
            key + ' = ' + json.dumps(value, ensure_ascii=False)
            for key, value in (('name', role), ('description', 'codex-method ' + role),
                               ('developer_instructions', instructions))) + '\n'
    return result


def config_text(text):
    """Preserve unrelated bytes; refuse inline layouts we cannot edit without rewriting them."""
    parsed = tomllib.loads(text)
    existing = parsed.get('features', {}).get('multi_agent_v2', {})
    require(isinstance(existing, dict), 'features.multi_agent_v2 must be a table')
    if all(existing.get(key) is True for key in FEATURES):
        return text
    section = re.search(r'^\[features\.multi_agent_v2\]\s*(?:#.*)?$', text, re.M)
    if section:
        next_section = re.search(r'^\[', text[section.end():], re.M)
        end = section.end() + next_section.start() if next_section else len(text)
        body = text[section.end():end]
        for key in FEATURES:
            pattern = rf'^{key}\s*=.*$'
            if re.search(pattern, body, re.M):
                body = re.sub(pattern, key + ' = true', body, flags=re.M)
            else:
                body = body.rstrip() + '\n' + key + ' = true\n'
        result = text[:section.end()] + body + text[end:]
    else:
        require(not existing, 'unsupported inline/dotted multi_agent_v2 layout; use a table')
        result = text.rstrip() + '\n\n[features.multi_agent_v2]\n' + ''.join(
            key + ' = true\n' for key in FEATURES)
    # Duplicate tables/inline tables are refused before touching any files.
    effective = tomllib.loads(result)['features']['multi_agent_v2']
    require(all(effective.get(key) is True for key in FEATURES), 'V2 config generation failed')
    return result


def user_directory():
    """Resolve Codex's standard user root without changing the current host settings."""
    return Path(os.environ.get('CODEX_HOME', str(Path.home() / '.codex'))).expanduser().absolute()


def planned_directory(directory):
    require(not directory.is_symlink(), 'Codex configuration directory must not be a symlink')
    config = directory / 'config.toml'
    require(not config.is_symlink(), 'project config must not be a symlink')
    original = config.read_text() if config.exists() else ''
    parsed = tomllib.loads(original)
    agents = directory / 'agents'
    require(not agents.is_symlink(), 'project agents directory must not be a symlink')
    roles = role_files()
    names = {name.removesuffix('.toml') for name in roles}
    require(not names.intersection(parsed.get('agents', {})), 'method role collides with config agents')
    for path in agents.rglob('*.toml'):
        require(not path.is_symlink(), 'agent file must not be a symlink')
        body = path.read_text()
        name = tomllib.loads(body).get('name')
        if name in names or path.name in roles:
            require(path.parent == agents and path.name in roles and body.startswith(OWNED_MARKERS),
                    f'method role collision at {path}; preserve the existing role')
    return {config: config_text(original), **{agents / name: body for name, body in roles.items()}}


def planned(project):
    return planned_directory(project / '.codex')


def planned_user(codex_home=None):
    return planned_directory(codex_home if codex_home is not None else user_directory())


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    scope = parser.add_mutually_exclusive_group(required=True)
    scope.add_argument('--project', type=Path, help='install only in the explicitly selected project')
    scope.add_argument('--user', action='store_true', help='install in the Codex user config layer')
    parser.add_argument('--host-version', required=True, help='observed host version; only 0.160.0 is qualified')
    parser.add_argument('--check', action='store_true', help='read-only generation drift check')
    args = parser.parse_args()
    require(args.host_version == VERSION, f'only Codex {VERSION} V2 is qualified')
    project = args.project.resolve() if args.project is not None else None
    if project is not None:
        require(project.is_dir(), 'explicit target project must exist')
    directory = user_directory() if args.user else project / '.codex'
    writes = planned_user(directory) if args.user else planned(project)
    drift = [str(path) for path, body in writes.items()
             if not path.is_file() or path.read_text() != body]
    backups = []
    if args.check:
        require(not drift, 'installation drift: ' + ', '.join(drift))
    else:
        existing = [path for path in writes if str(path) in drift and path.is_file()]
        if existing:
            # Role discovery is recursive; keeping backup TOML outside agents prevents collisions.
            backup = directory / 'codex-method-backups' / uuid.uuid4().hex
            backup.mkdir(parents=True, mode=0o700)
            for path in existing:
                destination = backup / path.relative_to(directory)
                destination.parent.mkdir(parents=True, exist_ok=True, mode=0o700)
                shutil.copy2(path, destination)
                destination.chmod(0o600)
                backups.append(str(destination))
        for path, body in writes.items():
            if str(path) in drift:
                path.parent.mkdir(parents=True, exist_ok=True)
                path.write_text(body)
    print(json.dumps({'scope': 'user' if args.user else 'project',
                      'project': str(project) if project is not None else None,
                      'codex_home': str(directory) if args.user else None,
                      'host_version': args.host_version, 'backups': backups,
                      'status': 'checked' if args.check else 'installed', 'files': list(map(str, writes)),
                      'notice': 'Start a new trusted session and load the hook plugin separately. '
                      'Roles inherit parent cwd and permissions; OS-per-child isolation is unsupported.'}))


if __name__ == '__main__':
    try:
        main()
    except (Refusal, OSError, ValueError) as error:
        print(f'install refused: {error}', file=sys.stderr)
        sys.exit(1)
