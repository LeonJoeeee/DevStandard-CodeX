#!/usr/bin/env python3
"""The integrating session's merge entry point; verification is read-only by default."""
import argparse
import json
import sys
from pathlib import Path

ROOT = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(ROOT / 'scripts'))
from hard_edges import Refusal, api, merged_result, protection_check, require, resolved, run  # noqa: E402
from review_state import accepted, ledger_path, load, locked  # noqa: E402
from acceptance_reuse import capture, require_context, validate_reuse_files, verify_reuse  # noqa: E402


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('action', choices=['merge','compare','protection'])
    parser.add_argument('--repo')
    parser.add_argument('--pr', type=int)
    parser.add_argument('--branch', default='main')
    parser.add_argument('--project', type=Path, default=Path.cwd())
    parser.add_argument('--execute', action='store_true')
    parser.add_argument('--check', action='append', dest='checks')
    parser.add_argument('--ci-app-id', type=int, default=15368,
                        help='required integration-check producing app (GitHub Actions by default)')
    parser.add_argument('--ci-fallback', help='unqualified fallback always blocks; never a check waiver')
    parser.add_argument('--apply', action='store_true')
    parser.add_argument('--old-base')
    parser.add_argument('--old-head')
    parser.add_argument('--base')
    parser.add_argument('--head')
    parser.add_argument('--reuse', type=int, help='exact published accepted-review reuse receipt id')
    args = parser.parse_args()
    project = resolved(args.project, 'project')
    if args.action == 'protection':
        require(args.repo, 'protection needs --repo')
        if args.apply:
            from protection import protection_apply
            state = protection_apply(args.repo, args.branch, args.checks, cwd=project)
        else:
            state = protection_check(args.repo, args.branch)
        print(json.dumps({'action':'protection','branch':args.branch, **state}, indent=2))
        return
    if args.action == 'compare':
        require(all([args.old_base,args.old_head,args.base,args.head]), 'compare needs all four SHAs')
        old = run('git','diff','--no-ext-diff','--no-textconv',args.old_base,args.old_head,cwd=project)
        new = run('git','diff','--no-ext-diff','--no-textconv',args.base,args.head,cwd=project)
        changed = run('git','diff','--no-ext-diff','--no-textconv','--name-only',
                      args.old_head,args.head,cwd=project)
        print(json.dumps({'action':'compare','patches_identical':old==new,
                          'trees_identical':not changed, 'changed_paths':changed.splitlines(),
                          'acceptance_reused':False}, indent=2))
        return
    require(args.repo and args.pr, 'merge needs --repo and --pr')
    with locked(project, args.repo, args.pr) as ledger:
        initial = load(ledger_path(project, args.repo, args.pr), args.repo, args.pr)
        verify_merge(args, project, ledger, initial)


def verify_merge(args, project, ledger, initial):
    require(not args.ci_fallback,
            'CI fallback is not qualified at this boundary; retain evidence and wait, never waive CI')
    repo = api(f'repos/{args.repo}')
    default = repo['default_branch']
    pr = api(f'repos/{args.repo}/pulls/{args.pr}')
    require(pr['state'] == 'open', 'the PR is not open')
    require(pr['base']['ref'] == default, f'the PR does not target the current default branch {default}')
    head = pr['head']['sha']
    current = api(f'repos/{args.repo}/git/ref/heads/{default}')['object']['sha']
    base = pr['base']['sha']
    require(base == current, 'PR base differs from the current default-branch tip')
    comparison = api(f'repos/{args.repo}/compare/{base}...{head}')
    require(comparison.get('behind_by') == 0 and comparison.get('status') in ('ahead','identical'),
            'PR head does not contain the current base')
    pages = api(f'repos/{args.repo}/issues/{args.pr}/comments', '--paginate','--slurp') or []
    comments = [c for page in pages for c in page]
    current = None
    if args.reuse:
        require(ledger['attempts'], 'no original accepted review receipt')
        current = capture(args.repo, args.pr, ledger['attempts'][-1]['issue'])
        attempt, proof = verify_reuse(project, ledger, current, args.reuse)
        require(proof['head'] == head and proof['base'] == base, 'selected proof head or base differs')
        require(args.ci_app_id == 15368, 'reuse requires ordinary GitHub Actions integration evidence')
    else:
        attempt, _ = accepted(project, args.repo, args.pr, comments, head, base, ledger)
        if attempt.get('context'):
            current = capture(args.repo, args.pr, attempt['issue'])
            require_context(attempt, ledger, current)
    pages = api(f'repos/{args.repo}/commits/{head}/check-runs', '--paginate','--slurp') or []
    checks = [c for page in pages for c in page.get('check_runs',[])]
    latest = {}
    for check in checks:
        key = (check['name'], (check.get('app') or {}).get('id'))
        if key not in latest or check['id'] > latest[key]['id']:
            latest[key] = check
    integration = merged_result(base,head)
    integrated = latest.get((integration,args.ci_app_id))
    require(integrated and integrated.get('status') == 'completed'
            and integrated.get('conclusion') == 'success',
            f'{integration} is not green from producing app {args.ci_app_id}')
    failed = [c['name'] for c in latest.values() if c.get('status') == 'completed'
              and c.get('conclusion') not in ('success','neutral','skipped')]
    require(not failed, f'failed checks on the head: {failed}')
    after = api(f'repos/{args.repo}/pulls/{args.pr}')
    base_after = api(f'repos/{args.repo}/git/ref/heads/{default}')['object']['sha']
    require(after['state'] == 'open' and after['head']['sha'] == head
            and after['base']['sha'] == base and base_after == base,
            'PR head or base moved during verification; verify again')
    require(load(ledger_path(project, args.repo, args.pr), args.repo, args.pr) == initial,
            'local review ledger moved during verification')
    if current:
        final = capture(args.repo, args.pr, attempt['issue'])
        require(current['fields'] == final['fields']
                and final['raw']['pr']['head']['sha'] == head
                and final['raw']['pr']['base']['sha'] == base,
                'review context/head/base moved during verification')
        if args.reuse:
            validate_reuse_files(proof)
            accepted(project,args.repo,args.pr,final['raw']['pr_comments'],
                     proof['old_head'],proof['old_base'],ledger)
            require_context(attempt,ledger,final,
                            proof['proof']['replacement'] if proof['kind'] == 'external' else None)
        else:
            # Re-read original packet/instruction/verdict association too.
            accepted(project,args.repo,args.pr,final['raw']['pr_comments'],head,base,ledger)
            require_context(attempt, ledger, final)
        require(api(f'repos/{args.repo}/git/ref/heads/{default}')['object']['sha'] == base,
                'default base moved at verification end')
    require(load(ledger_path(project,args.repo,args.pr),args.repo,args.pr) == initial,
            'local review ledger moved at verification end')
    if not args.execute:
        print(json.dumps({'action':'merge','merge':'pass','head':head,'base':base,
                          'attempt':attempt['comment_id']}, indent=2))
        return
    # The server enforces branch protection. Pin the head at the mutation too;
    # deleting branches belongs to separately inspected integrated-lane cleanup.
    run('gh','pr','merge',str(args.pr),'--repo',args.repo,'--squash',
        '--match-head-commit',head,cwd=project)
    print(json.dumps({'action':'merge','merged':True,'head':head,'base':base}, indent=2))


if __name__ == '__main__':
    try:
        main()
    except (Refusal,ValueError,OSError) as error:
        print(f'guard refused: {error}', file=sys.stderr)
        sys.exit(1)
