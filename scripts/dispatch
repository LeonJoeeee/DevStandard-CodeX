#!/usr/bin/env python3
"""Prepare fresh Codex 0.160.0 V2 spawn arguments; no agent process is executed.

The caller uses native spawn_agent, records its returned task_name with --record-spawn, and
captures list_agents output with --record-status. Receipts are caller-supplied observations, not
authenticated runtime attestations. Roles inherit parent cwd and permissions; OS-per-child
isolation is unsupported. Every child command must use the brief's worktree as workdir.
"""
import argparse
from contextlib import contextmanager
from datetime import datetime, timezone
import json
import re
import runpy
import subprocess
import sys
import tomllib
import uuid
from pathlib import Path
from urllib.parse import quote

ROOT = Path(__file__).resolve().parents[1]
sys.path.insert(0, str(ROOT / 'scripts'))
from hard_edges import Refusal, anchored_roles, filled, require, resolved, run
from review_state import digest, save as durable_save
import filelock


def route_setting(purpose, model=None, effort=None):
    rows = {role: (m, e) for role, m, e in anchored_roles(ROOT)}
    require(purpose in rows, f'no anchored {purpose} row')
    default_model, default_effort = rows[purpose]
    return filled(model or default_model, 'model'), filled(effort or default_effort, 'effort')


def slug(text):
    return re.sub(r'[^a-z0-9]+', '-', text.lower()).strip('-')[:48].rstrip('-') or 'task'


def now():
    return datetime.now(timezone.utc).isoformat()


def read_json(path):
    require(path and path.is_file(), f'evidence file is required: {path}')
    return json.loads(path.read_text(encoding='utf-8'))


def write_json(path, data):
    durable_save(path, data)


def lanes_directory(project):
    common = run('git', 'rev-parse', '--path-format=absolute', '--git-common-dir', cwd=project).strip()
    return resolved(common, 'common git directory') / 'codex-method' / 'lanes'


def record_name(issue, purpose):
    return f'{issue}' + ('-reviewer' if purpose == 'reviewer' else '') + '.json'


def validate_record(record, path):
    require(isinstance(record, dict) and record.get('interface') == 'codex-v2',
            f'unqualified lane record: {path}; preserve it and inspect its originating run')
    issue, purpose = record.get('issue'), record.get('purpose')
    require(isinstance(issue, int) and issue > 0 and purpose in ('worker', 'reviewer')
            and path.name == record_name(issue, purpose), f'lane record identity differs: {path}')
    require(all(isinstance(record.get(key), str) and record[key]
                for key in ('repo', 'lane_id', 'branch', 'worktree', 'base', 'status'))
            and isinstance(record.get('runs'), list) and record['runs'],
            f'incomplete lane receipt: {path}; do not infer completion')
    require(all(isinstance(item, dict) and item.get('lane_id') and item.get('task_name')
                for item in record['runs']), f'incomplete native run history: {path}')
    require(isinstance(record.get('host_version'), str) and record['host_version'],
            f'missing historical native host version: {path}; preserve the original receipt')
    for item in record['runs']:
        item.setdefault('host_version', record['host_version'])
        require(isinstance(item['host_version'], str) and item['host_version'],
                f'missing historical native run version: {path}')
    return record


def same_lane_history(older, current):
    keys = ('issue', 'repo', 'purpose', 'branch', 'base')
    return (all(older[key] == current[key] for key in keys)
            and resolved(older['worktree'], 'worktree') == resolved(current['worktree'], 'worktree')
            and [(r['lane_id'], r['task_name']) for r in older['runs']]
            == [(r['lane_id'], r['task_name']) for r in current['runs'][:len(older['runs'])]]
            and all(old['host_version'] == live['host_version']
                    and (not old.get('native_task_name')
                         or old['native_task_name'] == live.get('native_task_name'))
                    for old, live in zip(older['runs'], current['runs'])))


def reconcile_legacy(project, lanes):
    """Import one unambiguous old receipt under the shared lock; keep every old copy."""
    listed = run('git', 'worktree', 'list', '--porcelain', '-z', cwd=project)
    checkouts = [Path(item[len('worktree '):]) for item in listed.split('\0')
                 if item.startswith('worktree ')]
    candidates = {}
    for checkout in checkouts:
        for path in (checkout / '.codex-method/lanes').glob('*.json'):
            record = validate_record(read_json(path), path)
            candidates.setdefault(path.name, []).append((path, record, digest(path.read_bytes().decode('utf-8'))))
    imports = []
    for name, copies in candidates.items():
        target = lanes / name
        if target.exists():
            current = validate_record(read_json(target), target)
            require(all(same_lane_history(record, current) for _, record, _ in copies),
                    f'conflicting legacy lane records for {name}; preserve them and inspect native handles')
            sources = current.get('legacy_records', {})
            require(isinstance(sources, dict), 'legacy receipt history is malformed')
            for path, _, fingerprint in copies:
                require(str(path) not in sources or sources[str(path)] == fingerprint,
                        f'legacy receipt changed after migration: {path}; inspect its original native handles')
            refreshed = {**sources, **{str(path): fingerprint for path, _, fingerprint in copies}}
            if refreshed != sources:
                current['legacy_records'] = refreshed
                imports.append((target, current))
        else:
            first = copies[0][1]
            require(all(record == first for _, record, _ in copies),
                    f'conflicting legacy lane records for {name}; preserve them and inspect native handles')
            imports.append((target, {**first, 'legacy_records':
                                     {str(path): fingerprint for path, _, fingerprint in copies}}))
    # Validate the entire inventory before creating any reconciled receipt.
    for target, record in imports:
        write_json(target, record)


def writer_ownership(project, issue, branch, worktree):
    for path in lanes_directory(project).glob('*.json'):
        record = validate_record(read_json(path), path)
        if record['purpose'] != 'worker' or record['status'] == 'cleaned' or record['issue'] == issue:
            continue
        require(record['branch'] != branch and resolved(record['worktree'], 'worktree') != worktree,
                f'issue {record["issue"]} already owns this branch/worktree; preserve its writer and receipt')


def record_language(project):
    path = project / 'AGENTS.md'
    if not path.exists():
        return 'English'
    text = path.read_text(encoding='utf-8')
    headings = list(re.finditer(r'^##[ \t]+(?:Record language|记录语言)[ \t]*$', text, re.M | re.I))
    if not headings:
        return 'English'
    require(len(headings) == 1, 'ambiguous root AGENTS.md record-language declarations')
    tail = text[headings[0].end():]
    end = re.search(r'^#{1,2}[ \t]', tail, re.M)
    section = tail[:end.start()] if end else tail
    languages = []
    for line in section.splitlines():
        line = re.sub(r'^\s*[-*]\s+', '', line).strip()
        for pattern in (r'^(.+?)\s+is\s+(?:the\s+)?canonical\b',
                        r'^(?:Canonical record language|Record language|规范记录语言|记录语言|规范语言)\s*[:：]\s*([^.;；。]+)',
                        r'^([^是为：:]+?)[ \t]*(?:是|为).*(?:规范|正式|统一).*(?:语言|记录)'):
            match = re.match(pattern, line, re.I)
            if match:
                languages.append(match[1].strip().strip('`*_'))
                break
    require(len(languages) == 1 and languages[0],
            'root AGENTS.md must declare one explicit canonical record language; do not guess')
    return languages[0]


@contextmanager
def locked(project, issue, purpose):
    lanes = lanes_directory(project)
    lanes.mkdir(parents=True, exist_ok=True)
    with (lanes / 'ownership.lock').open('a') as lock:
        if not filelock.try_lock(lock.fileno()):
            raise Refusal('lane ownership is locked; inspect the originating dispatch before retrying')
        reconcile_legacy(project, lanes)
        yield lanes / record_name(issue, purpose)


def qualify(project, version):
    require(version == '0.160.0', 'only an observed Codex 0.160.0 V2 host is qualified; upgrade and use --host-version')
    installer = runpy.run_path(str(ROOT / 'scripts/install'))
    expected = installer['planned'](project)
    roles = [path for path in expected if path.parent.name == 'agents']
    if any(path.exists() for path in roles):
        require(all(path.is_file() and path.read_text(encoding='utf-8') == text for path, text in expected.items()),
                'project roles or V2 config are missing/stale; repair project installation, never hide drift with user roles')
    else:
        config = project / '.codex/config.toml'
        features = (tomllib.loads(config.read_text(encoding='utf-8')).get('features', {}).get('multi_agent_v2', {})
                    if config.exists() else {})
        require(all(key not in features or features[key] is True
                    for key in ('enabled', 'expose_spawn_agent_model_overrides')),
                'project disables native V2/overrides; repair that declaration before using user roles')
        expected = installer['planned_user'](installer['user_directory']())
        require(all(path.is_file() and path.read_text(encoding='utf-8') == text for path, text in expected.items()),
                'native user roles or V2 config are missing/stale; run scripts/install --user or install project roles')
    return installer


def lane_check(project, branch, worktree, base):
    require(worktree.is_dir(), 'the recorded worktree is missing')
    top = resolved(run('git', 'rev-parse', '--show-toplevel', cwd=worktree).strip(), 'worktree')
    require(top == worktree, 'worktree top level differs from the recorded lane')
    gitdir = resolved(run('git', 'rev-parse', '--absolute-git-dir', cwd=worktree).strip(), 'gitdir')
    common = resolved(run('git', 'rev-parse', '--path-format=absolute', '--git-common-dir',
                          cwd=worktree).strip(), 'common')
    project_common = resolved(run('git', 'rev-parse', '--path-format=absolute', '--git-common-dir',
                                  cwd=project).strip(), 'common')
    require(gitdir != common and common == project_common,
            'the lane must be a linked worktree of the target project')
    require(run('git', 'branch', '--show-current', cwd=worktree).strip() == branch,
            'current branch differs from the recorded lane')
    run('git', 'rev-parse', '--verify', base + '^{commit}', cwd=project)
    return run('git', 'rev-parse', 'HEAD', cwd=worktree).strip()


def captured_status(record, path, fresh=False):
    data = read_json(path)
    if fresh:
        prior = record['runs'][-1].get('status_observation') or record['runs'][-1].get('spawn_observation')
        since = (prior or {}).get('observed_at', record['runs'][-1]['prepared_at'])
        require(path.stat().st_mtime >= datetime.fromisoformat(since).timestamp(),
                'capture a new native list_agents result after the last recorded observation')
    require(isinstance(data, dict) and isinstance(data.get('agents'), list),
            'status evidence must be the whole native list_agents result')
    handle = record['runs'][-1].get('native_task_name')
    require(handle, 'record the native spawn receipt before status')
    matches = [agent for agent in data['agents'] if isinstance(agent, dict) and agent.get('agent_name') == handle]
    require(len(matches) == 1, 'native task handle is absent or ambiguous in list_agents evidence')
    status = matches[0].get('agent_status')
    known = status in ('pending_init', 'running', 'interrupted', 'shutdown', 'not_found') if isinstance(status, str) else False
    known = known or (isinstance(status, dict) and len(status) == 1
                      and (('completed' in status and (status['completed'] is None or isinstance(status['completed'], str)))
                           or ('errored' in status and isinstance(status['errored'], str))))
    require(known, 'unknown native agent_status; no liveness inference is allowed')
    # Not-found and interrupted are not finished evidence. A flag never stops a native child.
    finished = status == 'shutdown' or (isinstance(status, dict) and 'completed' in status)
    return data, status, finished


def observe(record, path, spawn=False):
    latest = record['runs'][-1]
    if spawn:
        require(record['status'] == 'awaiting-native-spawn' and not latest.get('native_task_name'),
                'this run already has a native handle')
        data = read_json(path)
        handle = data.get('task_name') if isinstance(data, dict) else None
        require(isinstance(handle, str) and re.fullmatch(r'/root(?:/[a-z0-9_]+)+', handle)
                and handle.endswith('/' + latest['task_name']),
                'spawn receipt must name the exact requested canonical task_name')
        latest['native_task_name'] = handle
        latest['spawn_observation'] = {'observed_at': now(), 'result': data}
        record['status'] = 'native-spawn-recorded'
    else:
        data, status, finished = captured_status(record, path, fresh=True)
        latest['status_observation'] = {'observed_at': now(), 'result': data}
        latest['finished'] = finished
        record['status'] = 'finished' if finished else 'native-unfinished'
    return record


def direct_ref(project, ref):
    symbolic = subprocess.run(['git', 'symbolic-ref', '-q', ref], cwd=project,
                              capture_output=True, text=True, encoding='utf-8')
    require(symbolic.returncode == 1, f'{ref} is symbolic or unreadable; preserve its target')
    lines = run('git', 'for-each-ref', '--format=%(refname) %(objectname)', ref, cwd=project).splitlines()
    matches = [line.split(' ', 1)[1] for line in lines if line.startswith(ref + ' ')]
    require(len(matches) <= 1, f'ambiguous ref identity: {ref}')
    return matches[0] if matches else None


def ancestor(project, head, base):
    result = subprocess.run(['git', 'merge-base', '--is-ancestor', head, base], cwd=project,
                            capture_output=True, text=True, encoding='utf-8')
    require(result.returncode in (0, 1), f'integration ancestry unavailable: {result.stderr}')
    return result.returncode == 0


def cleanup_proof(project, record, number):
    repo = record['repo']
    require(re.fullmatch(r'[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+', repo), 'invalid cleanup repository')
    actual = json.loads(run('gh', 'repo', 'view', '--json', 'nameWithOwner', cwd=project))
    require(actual.get('nameWithOwner') == repo, 'caller repository differs from the lane')
    repository = json.loads(run('gh', 'api', f'repos/{repo}', cwd=project))
    url = f'https://github.com/{repo}.git'
    require(repository.get('full_name') == repo and repository.get('clone_url') == url,
            'verified repository fetch identity differs')
    pr = json.loads(run('gh', 'api', f'repos/{repo}/pulls/{number}', cwd=project))
    require(pr.get('number') == number and pr.get('html_url') == record['pr']
            and pr.get('merged') is True and pr.get('state', '').lower() == 'closed',
            'cleanup requires this exact merged PR identity and integration evidence')
    require(pr.get('head', {}).get('repo', {}).get('full_name') == repo
            and pr.get('base', {}).get('repo', {}).get('full_name') == repo
            and pr['head'].get('ref') == record['branch'], 'PR repository/branch differs from the lane')
    head, integration, base = pr['head'].get('sha'), pr.get('merge_commit_sha'), pr['base'].get('ref')
    require(all(isinstance(sha, str) and re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}', sha)
                for sha in (head, integration)), 'merged PR head/integration commit is missing or invalid')
    require(isinstance(base, str) and base, 'merged PR base branch is missing')
    base_ref = 'refs/heads/' + base
    run('git', 'check-ref-format', base_ref, cwd=project)
    endpoint = f'repos/{repo}/git/ref/heads/{quote(base, safe="")}'
    def current_base():
        observed = json.loads(run('gh', 'api', endpoint, cwd=project))
        require(observed.get('ref') == base_ref and observed.get('object', {}).get('type') == 'commit',
                'current PR base API identity differs')
        sha = observed['object'].get('sha')
        require(isinstance(sha, str) and re.fullmatch(r'[0-9a-f]{40}|[0-9a-f]{64}', sha),
                'current PR base commit is unavailable')
        return sha
    base_sha = current_base()
    run('git', 'fetch', '--no-tags', '--no-recurse-submodules', url, base_ref, cwd=project)
    fetched = run('git', 'rev-parse', '--verify', 'FETCH_HEAD^{commit}', cwd=project).strip()
    require(fetched == base_sha == current_base(), 'current PR base moved or fetched identity differs; retry fresh proof')
    for sha in (head, integration, base_sha):
        require(run('git', 'rev-parse', '--verify', sha + '^{commit}', cwd=project).strip() == sha,
                'cleanup object identity differs')
    require(ancestor(project, integration, base_sha), 'integration commit is not reachable on current PR base; preserve work')
    trees = {key: run('git', 'rev-parse', sha + '^{tree}', cwd=project).strip()
             for key, sha in (('head_tree', head), ('integration_tree', integration))}
    route = 'ancestor' if ancestor(project, head, base_sha) else 'squash'
    require(route == 'ancestor' or trees['head_tree'] == trees['integration_tree'],
            'integration content differs from exact lane head; preserve original commits')
    local = subprocess.run(['git', 'rev-parse', '--verify', base_ref + '^{commit}'], cwd=project,
                           capture_output=True, text=True, encoding='utf-8')
    local_base = local.stdout.strip() if local.returncode == 0 else None
    return pr, dict(local_base_sha=local_base, local_base_stale=local_base != base_sha,
                    repo=repo, pr=record['pr'], lane_id=record['lane_id'], branch=record['branch'],
                    worktree=record['worktree'], head=head, integration_sha=integration,
                    base_ref=base_ref, base_sha=base_sha, route=route, **trees)


def cleanup_inventory(project, record, intent=None):
    recorded_worktree = Path(record['worktree'])
    worktree = resolved(record['worktree'], 'worktree')
    branch_ref = 'refs/heads/' + record['branch']
    head = direct_ref(project, branch_ref)
    present = recorded_worktree.exists() or recorded_worktree.is_symlink()
    if intent and intent['phase'] == 'worktree-removing' and present:
        archive_head = direct_ref(project, intent['archive_ref'])
        raise Refusal(f"cleanup phase worktree-removing (removal may have begun); "
                      f"archive {intent['archive_ref']} at {archive_head}; branch {branch_ref} at {head}; "
                      f"path present {recorded_worktree}; preserve files and pending intent; "
                      'caller inspection/disposition is required before another deletion attempt')
    require(worktree == recorded_worktree and not recorded_worktree.is_symlink(),
            'recorded worktree path identity changed; preserve its files')
    if present:
        require(not intent or intent['phase'] in ('intent', 'archived'),
                'worktree path reappeared after removal; preserve its files')
        lane_head = lane_check(project, record['branch'], worktree, record['base'])
        require(head == lane_head, 'branch and linked-worktree head differ')
        require(not run('git', 'status', '--porcelain', '--untracked-files=all', '--ignored',
                        cwd=worktree).strip(), 'tracked, untracked, ignored or sole-copy leftovers must be preserved before cleanup')
    else:
        require(intent and intent.get('archive_verified'),
                'recorded worktree is missing without bound cleanup intent/archive; preserve branch')
    owner = None
    for field in run('git', 'worktree', 'list', '--porcelain', '-z', cwd=project).split('\0'):
        if field.startswith('worktree '):
            owner = resolved(field[9:], 'occupied worktree')
        elif field == 'branch ' + branch_ref:
            require(present and owner == worktree, 'another worktree uses the cleanup branch; preserve it')
    if intent:
        require(head == intent['head'] or (not present and head is None),
                'branch moved beyond the bound cleanup head; preserve committed work')
    return worktree, head, present


def preserve_archive(project, intent):
    ref, head = intent['archive_ref'], intent['head']
    current = direct_ref(project, ref)
    if current is None:
        require(not intent.get('archive_verified'), 'confirmed archive is missing; preserve remaining lane')
        # --no-deref is part of the transaction: even a dangling symbolic CAS winner refuses.
        run('git', 'update-ref', '--no-deref', ref, head, '0' * len(head), cwd=project)
    else:
        require(current == head, 'archive ownership/head conflicts; preserve it without overwrite')
    require(direct_ref(project, ref) == head, 'direct archive identity moved; preserve remaining lane')


def cleanup_upstream(project, record, intent):
    branch, ref, head = record['branch'], intent['archive_ref'], intent['head']
    remote = 'codex-method-cleanup-' + record['lane_id']
    values = subprocess.run(['git', 'config', '--get-all', f'branch.{branch}.merge'], cwd=project,
                            capture_output=True, text=True, encoding='utf-8')
    require(values.returncode in (0, 1), 'effective branch merge configuration is unreadable')
    sources = values.stdout.splitlines()
    require(len(sources) <= 1, 'multiple effective branch merge sources; preserve lane')
    collision = subprocess.run(['git', 'config', '--get-regexp', '^remote\\.' + re.escape(remote) + r'\.' ],
                               cwd=project, capture_output=True, text=True, encoding='utf-8')
    require(collision.returncode == 1, 'cleanup logical remote conflicts with effective configuration')
    source = sources[0] if sources else intent['base_ref']
    run('git', 'check-ref-format', source, cwd=project)
    flags = ['-c', f'branch.{branch}.remote={remote}', '-c', f'remote.{remote}.url=.',
             '-c', f'remote.{remote}.fetch={source}:{ref}']
    if not sources:
        flags += ['-c', f'branch.{branch}.merge={source}']
    require(run('git', *flags, 'rev-parse', '--symbolic-full-name', branch + '@{upstream}', cwd=project).strip() == ref
            and run('git', *flags, 'rev-parse', branch + '@{upstream}', cwd=project).strip() == head,
            'effective deletion upstream differs from exact archive/head')
    return flags


def cleanup(project, record, args, path):
    require(record['purpose'] == 'worker', 'review receipts do not own worktree teardown')
    require(args.pr and args.native_status, 'cleanup requires --pr and fresh --native-status list_agents evidence')
    recorded = record.get('pr') or ''
    expected = f"https://github.com/{record['repo']}/pull/{args.pr}"
    require(recorded == expected, 'cleanup PR differs from the recorded exact identity')
    data, status, finished = captured_status(record, args.native_status, fresh=True)
    require(finished, 'native child has no finished evidence; cleanup cannot stop it')
    for past in record['runs'][:-1]:
        _, _, past_finished = captured_status({'runs':[past]}, args.native_status, fresh=True)
        require(past_finished, 'a retained native handle is unfinished; preserve the lane')
    review_path = lanes_directory(project) / record_name(record['issue'], 'reviewer')
    if review_path.exists():
        review = read_json(review_path)
        require(review.get('interface') == 'codex-v2', 'reviewer lifetime is unqualified')
        if resolved(review['worktree'], 'review worktree') == resolved(record['worktree'], 'worktree'):
            for review_run in review['runs']:
                _, _, review_finished = captured_status({'runs':[review_run]}, args.native_status, fresh=True)
                require(review_finished, 'borrowing native reviewer has no finished evidence')
    intent = record.get('cleanup_intent')
    pr, proof = cleanup_proof(project, record, args.pr)
    archive = f"refs/codex-method/archive/{record['issue']}/{record['lane_id']}"
    run('git', 'check-ref-format', archive, cwd=project)
    if intent:
        require(isinstance(intent, dict) and intent.get('phase') in ('intent', 'archived', 'worktree-removing', 'worktree-removed', 'branch-removed'),
                'cleanup intent is unqualified; preserve all retained state')
        fixed = ('repo', 'pr', 'lane_id', 'branch', 'worktree', 'head', 'integration_sha', 'base_ref', 'head_tree', 'integration_tree')
        require(all(intent.get(key) == proof[key] for key in fixed) and intent.get('archive_ref') == archive,
                'cleanup intent identity changed; preserve retained state')
        require(direct_ref(project, archive) == intent['head'] or not intent.get('archive_verified'),
                'confirmed archive changed; preserve retained state')
    worktree, head, present = cleanup_inventory(project, record, intent)
    require(head == proof['head'] or (intent and not present and head is None),
            'lane contains unintegrated commits beyond the merged PR head')
    # Reject an unowned preexisting archive, even one coincidentally pointing to this head.
    if not intent:
        require(direct_ref(project, archive) is None, 'archive exists without owning cleanup intent; preserve it')
        intent = dict(proof, archive_ref=archive, phase='intent', archive_verified=False)
        record['cleanup_intent'] = intent
        record['runs'][-1]['status_observation'] = {'observed_at': now(), 'result': data}
        record['runs'][-1]['finished'] = True
        write_json(path, record)
    preserve_archive(project, intent)
    intent['archive_verified'] = True
    if intent['phase'] == 'intent':
        intent['phase'] = 'archived'
    intent['latest_proof'] = proof
    record['runs'][-1]['status_observation'] = {'observed_at': now(), 'result': data}
    record['runs'][-1]['finished'] = True
    write_json(path, record)
    try:
        flags = cleanup_upstream(project, record, intent) if head is not None else None
        # Re-fetch and recheck before the first destructive operation; later base advancement is fine.
        _, latest = cleanup_proof(project, record, args.pr)
        require(all(latest[key] == proof[key] for key in ('repo', 'pr', 'head', 'integration_sha', 'base_ref', 'head_tree', 'integration_tree')),
                'PR integration identity changed before removal')
        intent['latest_proof'] = latest
        worktree, head, present = cleanup_inventory(project, record, intent)
        require(direct_ref(project, archive) == intent['head'], 'archive moved before removal')
        write_json(path, record)
        if present:
            require(cleanup_upstream(project, record, intent) == flags, 'effective upstream settings moved before removal')
            # On restart a present path is ambiguous, even if this command never started.
            intent['phase'] = 'worktree-removing'
            write_json(path, record)
            run('git', 'worktree', 'remove', str(worktree), cwd=project)
            require(not worktree.exists(), 'worktree removal is incomplete; preserve remaining state')
            intent['phase'] = 'worktree-removed'
            write_json(path, record)
        _, head, present = cleanup_inventory(project, record, intent)
        require(not present and direct_ref(project, archive) == intent['head'], 'archive/worktree changed before branch deletion')
        if head is not None:
            require(cleanup_upstream(project, record, intent) == flags, 'effective upstream settings moved before deletion')
            run('git', *flags, 'branch', '-d', record['branch'], cwd=project)
        intent['phase'] = 'branch-removed'
        write_json(path, record)
        cleanup_inventory(project, record, intent)
        require(direct_ref(project, 'refs/heads/' + record['branch']) is None
                and direct_ref(project, archive) == intent['head'], 'final branch/archive identity differs')
        run('git', 'worktree', 'prune', cwd=project)
        record['runs'][-1]['status_observation'] = {'observed_at': now(), 'result': data}
        record['runs'][-1]['finished'] = True
        record['status'] = 'cleaned'
        record['cleanup'] = dict(at=now(), pr=pr, archive_ref=archive, original_head=intent['head'],
                                 proof=latest, recovery=f'git show {archive}',
                                 notice='Original head and reachable ancestry retained; branch config/reflog removed. '
                                        'Git may warn that the branch was merged to the archive rather than caller HEAD.')
        return record
    except (Refusal, OSError, ValueError, KeyError) as error:
        raise Refusal(f"cleanup stopped at {intent['phase']}; archive {archive}; "
                      f"preserve remaining branch/files and rerun cleanup with fresh evidence: {error}") from error


def issue_record(project, repo, issue):
    body = json.loads(run('gh', 'issue', 'view', str(issue), '--json', 'number,title,body,state', cwd=project))
    require(body.get('number') == issue and str(body.get('state', '')).lower() == 'open',
            f'issue {issue} is missing or is not open')
    pages = json.loads(run('gh', 'api', f'repos/{repo}/issues/{issue}/comments',
                          '--paginate', '--slurp', cwd=project))
    require(isinstance(pages, list) and all(isinstance(page, list) for page in pages),
            'ordered comment pagination returned an unknown shape')
    comments = [comment for page in pages for comment in page]
    require(all(isinstance(c, dict) and isinstance(c.get('body'), str)
                and c.get('created_at') and c.get('user', {}).get('login') for c in comments),
            'issue comments are incomplete')
    # Keep every complete record, including dispatch records; no trimming or selective rewriting.
    require(all(isinstance(c.get('id'), int) for c in comments), 'comment identity is missing')
    comments.sort(key=lambda c: c['id'])
    require(len({c['id'] for c in comments}) == len(comments), 'duplicate paginated issue comments')
    return body, comments


def prepare(project, record, args, installer):
    extra, language = args.input_text, args.record_language
    require(not record or not record.get('cleanup_intent'), 'cleanup is pending; finish its bound teardown before redispatch')
    if args.cont:
        require(record and record['status'] == 'finished' and record['runs'][-1].get('finished'),
                'continuation requires recorded finished native evidence')
        require(args.brief and args.brief.is_file(), 'continuation requires an existing --brief')
        require(args.native_status, 'continuation requires fresh --native-status list_agents evidence')
        data, status, finished = captured_status(record, args.native_status, fresh=True)
        require(finished, 'native child is unfinished; continuation cannot create another writer')
        if record['runs'][-1]['host_version'] != args.host_version:
            require(isinstance(status, dict) and 'completed' in status,
                    'upgrading a historical lane requires a fresh completed observation of its real handle')
        record['runs'][-1]['status_observation'] = {'observed_at': now(), 'result': data}
        for flag, value in (('branch', args.branch), ('worktree', args.worktree), ('purpose', args.purpose)):
            if value is not None:
                actual = str(resolved(value, flag)) if flag == 'worktree' else value
                require(actual == record[flag], f'continuation {flag} differs from the recorded lane')
        require(not args.base or args.base == record['base'], 'continuation base differs from the recorded lane')
        require(not args.pr or record['pr'] == f"https://github.com/{record['repo']}/pull/{args.pr}",
                'continuation PR differs from recorded lane')
        purpose, branch, worktree, base = (record['purpose'], record['branch'],
                                          resolved(record['worktree'], 'worktree'), record['base'])
    else:
        require(not record, 'a lane already exists; continue with finished evidence instead of overwriting')
        require(args.purpose, '--purpose is required (worker or reviewer)')
        purpose = args.purpose
        branch, worktree, base = args.branch, args.worktree, args.base or 'origin/main'
    repo = json.loads(run('gh', 'repo', 'view', '--json', 'nameWithOwner', cwd=project))['nameWithOwner']
    if record:
        require(repo == record['repo'], 'project repository differs from recorded lane')
    issue, comments = issue_record(project, repo, args.issue)
    model, effort = route_setting(purpose, args.model, args.effort)
    packet = ''
    if purpose == 'reviewer':
        require(args.packet and args.packet.is_file(), 'reviewer requires the whole canonical filled --packet')
        packet = args.packet.read_text(encoding='utf-8')
        require(packet.strip(), 'review packet is empty')
    if args.adopt:
        require(branch and worktree, 'adoption requires explicit --branch and --worktree')
    branch = branch or f"task/{args.issue}-{slug(issue['title'])}"
    worktree = resolved(worktree or project / '.codex-method/worktrees' / f"{args.issue}-{slug(issue['title'])}", 'worktree')
    require(worktree != project, 'a lane must be a linked worktree, not the main checkout')
    if purpose == 'worker':
        writer_ownership(project, args.issue, branch, worktree)
    if not args.cont and not args.adopt:
        ignored = subprocess.run(['git', 'check-ignore', '-q', str(worktree / 'probe')], cwd=project).returncode == 0
        require(ignored, 'the worktree directory must be gitignored before creation')
        run('git', 'rev-parse', '--verify', base + '^{commit}', cwd=project)
        run('git', 'worktree', 'add', str(worktree), '-b', branch, base, cwd=project)
    lane_check(project, branch, worktree, base)
    lane_id = f'{args.issue}-{uuid.uuid4().hex}'
    scratch = lanes_directory(project) / str(args.issue) / lane_id
    scratch.mkdir(parents=True)
    brief, receipt = scratch / 'brief.txt', scratch / 'native-spawn.json'
    baseline = run('git', 'status', '--porcelain', '--untracked-files=all', cwd=worktree)
    role_name = 'method_' + purpose
    record_text = '\n\n'.join(
        f"Comment {c['id']} — {c['created_at']} — {c['user']['login']}\n"
        f"----- BEGIN COMMENT {c['id']} -----\n{c['body']}\n----- END COMMENT {c['id']} -----"
        for c in comments) or '(no comments)'
    text = (f'# Task packet\nIssue: https://github.com/{repo}/issues/{args.issue}\n'
            f'Branch: {branch}\nWorktree: {worktree}\nNamed base: {base}\n'
            f'Role references resolve from: {ROOT}\nRole: {purpose}\n'
            f'Executor: Codex {model} at {effort}\nRecord language: {language}\n'
            'Commit trailer: Co-Authored-By: codex-method worker <noreply@openai.com>\n')
    pr_url = record.get('pr') if record else (f'https://github.com/{repo}/pull/{args.pr}' if args.pr else None)
    if pr_url:
        text += f'PR: {pr_url}\n'
    text += (f'\nSet workdir={worktree} on EVERY exec_command and other command call. '
             'Native children inherit parent cwd and permissions; OS-per-child isolation and '
             'OS-enforced reviewer read-only mode are unsupported. The role hook guards ordinary '
             'operations; it is not adversarial credential isolation.\n'
             '\n----- BEGIN ISSUE BODY -----\n' + issue['body'] + '\n----- END ISSUE BODY -----\n'
             '\nWhole ordered issue record (all comments, verbatim):\n' + record_text + '\n'
             f'\nDiscovered native role: {role_name}. Its installed developer instructions '
             'supply the shared agreements, complete static role contract and native mechanics; '
             'this message supplies the fresh task binding.\n')
    if args.brief:
        label = 'Continuation brief' if args.cont else 'Inputs and expected output'
        text += '\n' + label + ' (verbatim):\n' + extra + '\n'
    if packet:
        text += '\nReview packet (verbatim):\n' + packet + '\n'
    brief.write_text(text, encoding='utf-8')
    task_name = 'issue_' + str(args.issue) + '_' + purpose + '_' + uuid.uuid4().hex[:12]
    spawn = {'task_name': task_name, 'message': text, 'agent_type': role_name,
             'fork_turns': 'none', 'model': model, 'reasoning_effort': effort}
    write_json(receipt, spawn)
    return {'kind':'run', 'lane_id':lane_id, 'issue':args.issue, 'repo':repo,
            'branch':branch, 'worktree':str(worktree), 'base':base, 'purpose':purpose,
            'model':model, 'effort':effort, 'brief':str(brief), 'instruction':str(receipt),
            'pr':pr_url, 'issue_state':issue['state'], 'status':'awaiting-native-spawn',
            'host_version':args.host_version, 'interface':'codex-v2',
            **({'legacy_records': record['legacy_records']} if record and record.get('legacy_records') else {}),
            'runs': (record['runs'] if record else []) + [
                {'lane_id':lane_id, 'task_name':task_name, 'brief':str(brief), 'host_version':args.host_version,
                 'instruction':str(receipt), 'prepared_at':now(), 'pre_write_status':baseline,
                 'finished':False}],
            'notice':'Prepared only. Call native spawn_agent with native-spawn.json exactly; '
            'capture its result via --record-spawn. Use list_agents for --record-status. '
            'Receipts must be actual host outputs; this CLI cannot authenticate them or stop a child.'}


def bind_pr(project, record, number):
    if number is None:
        return
    require(number > 0, 'PR number must be positive')
    expected = f"https://github.com/{record['repo']}/pull/{number}"
    if record.get('pr'):
        require(record['pr'] == expected, 'PR identity differs from the recorded lane')
        return
    pr = json.loads(run('gh', 'api', f"repos/{record['repo']}/pulls/{number}", cwd=project))
    head = lane_check(project, record['branch'], resolved(record['worktree'], 'worktree'), record['base'])
    require(pr.get('number') == number and pr.get('html_url') == expected
            and pr.get('head', {}).get('ref') == record['branch']
            and pr.get('head', {}).get('sha') == head
            and pr.get('head', {}).get('repo', {}).get('full_name') == record['repo']
            and pr.get('base', {}).get('repo', {}).get('full_name') == record['repo'],
            'returned PR does not match the exact lane repository, branch and head')
    record['pr'] = expected


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument('issue', type=int, nargs='?')
    parser.add_argument('--project', type=Path, default=Path.cwd())
    parser.add_argument('--host-version', help='observed host version; only 0.160.0 is qualified')
    parser.add_argument('--purpose', choices=['worker', 'reviewer'])
    parser.add_argument('--base')
    parser.add_argument('--branch')
    parser.add_argument('--worktree', type=Path)
    parser.add_argument('--brief', type=Path)
    parser.add_argument('--packet', type=Path)
    parser.add_argument('--pr', type=int)
    parser.add_argument('--model')
    parser.add_argument('--effort')
    actions = parser.add_mutually_exclusive_group()
    actions.add_argument('--continue', dest='cont', action='store_true')
    actions.add_argument('--adopt', action='store_true')
    actions.add_argument('--record-spawn', type=Path, help='captured native spawn_agent JSON result')
    actions.add_argument('--record-status', type=Path, help='captured native list_agents JSON result')
    actions.add_argument('--cleanup', action='store_true')
    parser.add_argument('--native-status', type=Path, help='fresh native list_agents capture for cleanup')
    args = parser.parse_args()
    require(args.issue and args.issue > 0, 'an issue number is required')
    project = resolved(args.project, 'project')
    require(project.is_dir(), 'target project does not exist')
    require(resolved(run('git', 'rev-parse', '--show-toplevel', cwd=project).strip(), 'project root') == project,
            '--project must be the actual checkout root; root AGENTS.md is the language authority')
    installer = qualify(project, args.host_version)
    if not (args.record_spawn or args.record_status or args.cleanup):
        # A bad brief/declaration cannot create ownership files, import legacy state, or create a worktree.
        args.input_text = args.brief.read_bytes().decode('utf-8') if args.brief else ''
        args.record_language = record_language(project)
    with locked(project, args.issue, args.purpose) as path:
        record = read_json(path) if path.exists() else None
        if record:
            validate_record(record, path)
        if args.record_spawn or args.record_status or args.cleanup:
            require(record and record.get('interface') == 'codex-v2' and record.get('status') != 'cleaned',
                    'no active qualified native lane record')
            if not args.cleanup:
                bind_pr(project, record, args.pr)
            record = (cleanup(project, record, args, path) if args.cleanup else
                      observe(record, args.record_spawn or args.record_status, bool(args.record_spawn)))
        else:
            record = prepare(project, record, args, installer)
        write_json(path, record)
        print(json.dumps(record, indent=2, ensure_ascii=False))


if __name__ == '__main__':
    try:
        main()
    except (Refusal, OSError, ValueError, KeyError) as error:
        print(f'dispatch refused: {error}', file=sys.stderr)
        sys.exit(1)
